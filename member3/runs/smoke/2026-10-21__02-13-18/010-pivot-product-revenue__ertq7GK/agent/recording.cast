[45.155277, "i", "cat > /tmp/update_sales.py <<'PY'\nimport openpyxl\nfrom openpyxl.styles import Font\nfrom openpyxl.utils import get_column_letter\np='/app/BoomerangSales.xlsx'\nw=openpyxl.load_workbook(p)\ns=w['Sheet1']\ncol=s.max_column+1\ns.cell(1,col,'Revenue')\nfor r in range(2,s.max_row+1):\n    s.cell(r,col, f'=E{r}*VLOOKUP(C{r},\\'Retail Price\\'!$A$2:$B$23,2,FALSE)*(1-F{r})')\n    s.cell(r,col).number_format='$#,##0.00'\n# Create summary sheet with a product revenue aggregation\nif 'Sheet2' in w: del w['Sheet2']\nt=w.create_sheet('Sheet2')\nt.append(['Product','Revenue'])\nfor c in t[1]: c.font=Font(bold=True)\nproducts=[]\nfor r in range(2,s.max_row+1):\n    prod=s.cell(r,3).value\n    if prod not in products: products.append(prod)\nfor i,prod in enumerate(products,2):\n    t.cell(i,1,prod)\n    t.cell(i,2,f'=SUMIF(Sheet1!$C$2:$C${s.max_row},A{i},Sheet1!${get_column_letter(col)}$2:${get_column_letter(col)}${s.max_row})')\n    t.cell(i,2).number_format='$#,##0.00'\nt.freeze_panes='A2'\nt.column_dimensions['A'].width=25\nt.column_dimensions['B'].width=16\ns.cell(1,col).font=Font(bold=True)\ns.column_dimensions[get_column_letter(col)].width=15\nw.calculation.fullCalcOnLoad=True\nw.calculation.forceFullCalc=True\nw.save(p)\nPY\npython3 /tmp/update_sales.py\nmkdir -p /tmp/lo_profile\nlibreoffice -env:UserInstallation=file:///tmp/lo_profile --headless --convert-to xlsx --outdir /tmp /app/BoomerangSales.xlsx >/tmp/lo.txt 2>&1 || cat /tmp/lo.txt\ncat /tmp/lo.txt\n"]
